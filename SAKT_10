# ======================================================
# MODEL 1 —— SAKT
# ======================================================
class SAKT(nn.Module):
    def __init__(self, n_q, d_model=128, n_heads=8, max_len=300):
        super().__init__()
        self.q_emb=nn.Embedding(n_q+1,d_model)
        self.c_emb=nn.Embedding(2,d_model)
        self.pos_emb=nn.Embedding(max_len,d_model)

        enc=nn.TransformerEncoderLayer(
            d_model=d_model,nhead=n_heads,
            dim_feedforward=4*d_model,
            dropout=0.1,batch_first=True
        )
        self.encoder=nn.TransformerEncoder(enc,1)
        self.fc=nn.Linear(d_model,1)

    def forward(self,pq,pc,nq):
        B,T=pq.size()
        pos=torch.arange(T,device=pq.device).unsqueeze(0).expand(B,T)
        x=self.q_emb(pq)+self.c_emb(pc.long())+self.pos_emb(pos)
        h=self.encoder(x)
        last=h[:,-1,:]
        nq_emb=self.q_emb(nq)
        out=self.fc(last+nq_emb).squeeze(-1)
        return torch.sigmoid(out)


# ======================================================
# MODEL 2 —— AKT
# ======================================================
class AKT(nn.Module):
    def __init__(self,n_questions,d_model=128,n_heads=8,max_len=300,dropout=0.1):
        super().__init__()
        self.q_emb=nn.Embedding(n_questions+1,d_model)
        self.c_emb=nn.Embedding(2,d_model)
        self.pos_emb=nn.Embedding(max_len,d_model)

        enc=nn.TransformerEncoderLayer(
            d_model=d_model,nhead=n_heads,
            dim_feedforward=4*d_model,
            dropout=dropout,batch_first=True
        )
        self.encoder=nn.TransformerEncoder(enc,1)

        self.q_proj=nn.Linear(d_model,d_model)
        self.k_proj=nn.Linear(d_model,d_model)
        self.v_proj=nn.Linear(d_model,d_model)

        self.fc1=nn.Linear(2*d_model,d_model)
        self.fc2=nn.Linear(d_model,1)
        self.act=nn.ReLU()
        self.drop=nn.Dropout(dropout)

        self.q_bias=nn.Embedding(n_questions+1,1)

    def forward(self,pq,pc,nq):
        B,T=pq.size()
        mask=(pq==0)

        pos=torch.arange(T,device=pq.device).unsqueeze(0).expand(B,T)
        x=self.q_emb(pq)+self.c_emb(pc.long())+self.pos_emb(pos)

        h=self.encoder(x,src_key_padding_mask=mask)

        nq_emb=self.q_emb(nq)
        q=self.q_proj(nq_emb).unsqueeze(1)
        k=self.k_proj(h)
        v=self.v_proj(h)

        logits=torch.bmm(q,k.transpose(1,2))/math.sqrt(h.size(-1))
        logits=logits.masked_fill(mask.unsqueeze(1),float("-inf"))
        att=F.softmax(logits,dim=-1)
        ctx=torch.bmm(att,v).squeeze(1)

        z=torch.cat([ctx,nq_emb],dim=-1)
        z=self.drop(self.act(self.fc1(z)))
        out=self.fc2(z).squeeze(-1)+self.q_bias(nq).squeeze(-1)
        return torch.sigmoid(out)


# ======================================================
# MODEL 3 —— UKT
# ======================================================
class UKT(nn.Module):
    def __init__(self,n_questions,d_model=128,n_heads=8,max_len=300,dropout=0.1):
        super().__init__()
        self.q_emb=nn.Embedding(n_questions+1,d_model)
        self.c_emb=nn.Embedding(2,d_model)
        self.concept_emb=nn.Embedding(n_questions+1,d_model)
        self.pos_emb=nn.Embedding(max_len,d_model)

        enc=nn.TransformerEncoderLayer(
            d_model=d_model,nhead=n_heads,
            dim_feedforward=4*d_model,
            dropout=dropout,batch_first=True
        )
        self.encoder=nn.TransformerEncoder(enc,1)

        self.q_proj=nn.Linear(d_model,d_model)
        self.k_proj=nn.Linear(d_model,d_model)
        self.v_proj=nn.Linear(d_model,d_model)

        self.fc1=nn.Linear(3*d_model,d_model)
        self.fc2=nn.Linear(d_model,1)
        self.act=nn.ReLU()
        self.drop=nn.Dropout(dropout)

        self.q_bias=nn.Embedding(n_questions+1,1)
        self.cpt_bias=nn.Embedding(n_questions+1,1)

    def forward(self,pq,pc,nq):
        B,T=pq.size()
        mask=(pq==0)

        past_cpt=pq  # no KC map → use question as concept
        next_cpt=nq

        pos=torch.arange(T,device=pq.device).unsqueeze(0).expand(B,T)
        x=self.q_emb(pq)+self.c_emb(pc.long())+self.concept_emb(past_cpt)+self.pos_emb(pos)

        h=self.encoder(x,src_key_padding_mask=mask)

        nq_emb=self.q_emb(nq)
        cpt_emb=self.concept_emb(next_cpt)
        query=nq_emb+cpt_emb

        q=self.q_proj(query).unsqueeze(1)
        k=self.k_proj(h)
        v=self.v_proj(h)

        logits=torch.bmm(q,k.transpose(1,2))/math.sqrt(h.size(-1))
        logits=logits.masked_fill(mask.unsqueeze(1),float("-inf"))
        att=F.softmax(logits,dim=-1)
        ctx=torch.bmm(att,v).squeeze(1)

        z=torch.cat([ctx,nq_emb,cpt_emb],dim=-1)
        z=self.drop(self.act(self.fc1(z)))
        out=self.fc2(z).squeeze(-1)
        out += self.q_bias(nq).squeeze(-1)+self.cpt_bias(next_cpt).squeeze(-1)

        return torch.sigmoid(out)


# ======================================================
# Train / Eval
# ======================================================
def run_epoch(loader, model, optimizer=None):
    training = optimizer is not None
    model.train() if training else model.eval()

    all_probs=[]
    all_labels=[]
    all_bins=[]
    total=0

    with torch.set_grad_enabled(training):
        for pq,pc,nq,nc,bins in loader:
            pq,pc,nq,nc = pq.to(DEVICE), pc.to(DEVICE), nq.to(DEVICE), nc.to(DEVICE)
            probs=model(pq,pc,nq)
            loss=F.binary_cross_entropy(probs,nc)

            if training:
                optimizer.zero_grad()
                loss.backward()
                optimizer.step()

            total+=loss.item()
            all_probs.append(probs.detach().cpu().numpy())
            all_labels.append(nc.cpu().numpy())
            all_bins.extend(bins)

    if len(all_probs)==0:
        return float("nan"),np.array([]),np.array([]),np.array([])

    return total/len(loader), np.concatenate(all_probs), np.concatenate(all_labels), np.array(all_bins)


def compute_fairness(probs,labels,bins,name):
    print(f"\n[{name} Fairness]")
    df=pd.DataFrame({"prob":probs,"label":labels,"bin":bins})
    df["pred"]=(df.prob>=0.5).astype(int)

    for g,sub in df.groupby("bin"):
        tp=((sub.pred==1)&(sub.label==1)).sum()
        fp=((sub.pred==1)&(sub.label==0)).sum()
        tn=((sub.pred==0)&(sub.label==0)).sum()
        fn=((sub.pred==0)&(sub.label==1)).sum()
        tpr=tp/(tp+fn+1e-9)
        fpr=fp/(fp+tn+1e-9)
        acc=(tp+tn)/len(sub)
        print(f" Bin {g}: size={len(sub)}  TPR={tpr:.3f}, FPR={fpr:.3f}, ACC={acc:.3f}")



# ======================================================
# Random eval（stratified pos/neg）+ threshold sweep
# ======================================================
def random_eval(model, students, pos_n=5, neg_n=5):
    model.eval()
    probs,labels,bins=[],[],[]

    with torch.no_grad():
        for stu in students:
            q,c,b = stu["q_seq"], stu["c_seq"], stu["comp_bin"]
            L=len(q)
            if L<3: continue

            pos_idx=[i for i in range(1,L) if c[i]==1]
            neg_idx=[i for i in range(1,L) if c[i]==0]

            pick=[]
            if len(pos_idx)>0: pick+=random.sample(pos_idx,min(pos_n,len(pos_idx)))
            if len(neg_idx)>0: pick+=random.sample(neg_idx,min(neg_n,len(neg_idx)))
            if len(pick)==0: continue

            for k in pick:
                pq=torch.tensor(q[:k]).unsqueeze(0).to(DEVICE)
                pc=torch.tensor(c[:k]).unsqueeze(0).to(DEVICE)
                nq=torch.tensor([q[k]]).to(DEVICE)
                y=c[k]

                prob=model(pq,pc,nq).item()
                probs.append(prob)
                labels.append(y)
                bins.append(b)

    probs=np.array(probs)
    labels=np.array(labels)
    bins=np.array(bins)

    pred=(probs>=0.5).astype(int)
    acc=accuracy_score(labels,pred)
    auc=roc_auc_score_manual(labels,probs)
    f1=f1_score_binary(labels,pred)

    print("\n===== RANDOM EVAL =====")
    print(f"AUC={auc:.4f}, ACC={acc:.4f}, F1={f1:.4f}, N={len(labels)}")

    # best threshold (no sklearn)
    best_f1=0
    best_t=0.5
    for t in np.linspace(0.05,0.95,181):
        p=(probs>=t).astype(int)
        f=f1_score_binary(labels,p)
        if f>best_f1:
            best_f1=f; best_t=t
    print(f"Best threshold: t={best_t:.3f}, F1={best_f1:.4f}")

    compute_fairness(probs,labels,bins,"Random")
    return auc,acc,f1,best_f1,best_t


# ======================================================
# Unified runner
# ======================================================
def run_model(model_name, n_questions):
    print(f"\n================ Running {model_name} ================")

    if model_name=="SAKT":
        model=SAKT(n_questions, D_MODEL, N_HEADS, MAX_SEQ_LEN).to(DEVICE)
    elif model_name=="AKT":
        model=AKT(n_questions, D_MODEL, N_HEADS, MAX_SEQ_LEN).to(DEVICE)
    elif model_name=="UKT":
        model=UKT(n_questions, D_MODEL, N_HEADS, MAX_SEQ_LEN).to(DEVICE)
    else:
        raise ValueError("Unknown model")

    optimizer=torch.optim.Adam(model.parameters(),lr=LR)

    # training
    for ep in range(1,EPOCHS+1):
        tr_loss, tr_p, tr_y, _ = run_epoch(train_loader,model,optimizer)
        va_loss, va_p, va_y, va_b = run_epoch(val_loader,model)

        pred=(va_p>=0.5).astype(int)
        acc=accuracy_score(va_y,pred)
        auc=roc_auc_score_manual(va_y,va_p)
        f1 =f1_score_binary(va_y,pred)
        print(f"Epoch {ep}: Val AUC={auc:.4f} Acc={acc:.4f} F1={f1:.4f}")

    # test
    te_loss, te_p, te_y, te_b = run_epoch(test_loader,model)
    print("\n--- Normal test evaluation ---")
    pred=(te_p>=0.5).astype(int)
    acc=accuracy_score(te_y,pred)
    auc=roc_auc_score_manual(te_y,te_p)
    f1 =f1_score_binary(te_y,pred)
    print("Test ACC=",acc,"AUC=",auc,"F1=",f1)
    compute_fairness(te_p,te_y,te_b,"Test")

    # random
    print("\n--- Random evaluation (each student stratified) ---")
    random_eval(model,test_s)


