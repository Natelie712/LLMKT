def set_seed(seed=42):
    random.seed(seed)
    np.random.seed(seed)
    torch.manual_seed(seed)
    if torch.cuda.is_available():
        torch.cuda.manual_seed_all(seed)

set_seed()

def accuracy_score(y_true, y_pred):
    y_true = np.asarray(y_true)
    return float((y_true == y_pred).mean())

def f1_score_binary(y_true, y_pred):
    y_true = np.asarray(y_true)
    y_pred = np.asarray(y_pred)
    tp = ((y_true==1)&(y_pred==1)).sum()
    fp = ((y_true==0)&(y_pred==1)).sum()
    fn = ((y_true==1)&(y_pred==0)).sum()
    if tp == 0:
        return 0.0
    prec = tp/(tp+fp+1e-9)
    rec  = tp/(tp+fn+1e-9)
    return float(2*prec*rec/(prec+rec+1e-9))

def roc_auc_score_manual(y_true, y_score):
    y_true = np.asarray(y_true)
    y_score = np.asarray(y_score)
    pos = y_true==1
    neg = y_true==0
    n_pos, n_neg = pos.sum(), neg.sum()
    if n_pos==0 or n_neg==0: return float("nan")
    order = np.argsort(y_score)
    ranks = np.empty_like(order, dtype=float)
    ranks[order] = np.arange(len(y_score))+1
    sum_r_pos = ranks[pos].sum()
    auc = (sum_r_pos - n_pos*(n_pos+1)/2)/(n_pos*n_neg)
    return float(auc)


# ======================================================
# STEP 1 — Preprocess CSV → student sequences
# ======================================================
def preprocess(csv_path, tot_q_slots=305):
    df = pd.read_csv(csv_path)
    qid_cols = [c for c in df.columns if re.match(r"q\d+_id$", c)]
    slot_nums = sorted(int(re.findall(r"\d+", c)[0]) for c in qid_cols)
    max_slot = max(slot_nums)

    students = []
    for _, row in df.iterrows():
        uid = row["UserId"]

        q_seq, c_seq = [], []
        for n in range(1, min(tot_q_slots, max_slot)+1):
            qid_col = f"q{n}_id"
            if qid_col not in df.columns: continue
            qid = row[qid_col]
            if pd.isna(qid): continue

            val = None
            for cc in [f"q{n}_correct", f"q{n}_answerchoiceselected_iscorrect"]:
                if cc in df.columns and not pd.isna(row[cc]):
                    val = row[cc]
                    break
            if val is None: continue

            val = int(val)
            q_seq.append(int(qid))
            c_seq.append(val)

        if len(q_seq)==0: continue
        L = len(q_seq)
        comp_bin = min(int((L/tot_q_slots)*10), 9)
        students.append({"user_id":uid, "q_seq":q_seq, "c_seq":c_seq, "comp_bin":comp_bin})

    print("Total students:", len(students))
    return students


students = preprocess(CSV_PATH, TOT_Q_SLOTS)


# ======================================================
# Dataset + Loader
# ======================================================
class KTSeq(Dataset):
    def __init__(self, students, max_seq=300):
        self.samples=[]
        for s in students:
            q,c,b = s["q_seq"], s["c_seq"], s["comp_bin"]
            if len(q)<3: continue
            for i in range(1,len(q)):
                st=max(0,i-max_seq)
                self.samples.append((
                    torch.tensor(q[st:i],dtype=torch.long),
                    torch.tensor(c[st:i],dtype=torch.float),
                    torch.tensor(q[i],dtype=torch.long),
                    torch.tensor(c[i],dtype=torch.float),
                    b
                ))

    def __len__(self): return len(self.samples)
    def __getitem__(self,i): return self.samples[i]

def pad_collate(batch):
    past_q, past_c, next_q, next_c, bins = zip(*batch)
    return (
        pad_sequence(past_q, batch_first=True, padding_value=0),
        pad_sequence(past_c, batch_first=True, padding_value=0),
        torch.stack(next_q),
        torch.stack(next_c),
        list(bins)
    )


